#Stack de monitorizacion de fabrica inteligente  entorno de ejemplo.
#Copiar a .env y rellenar con valores reales ANTES del primer arranque. Nunca hacer commit de .env.
#cp .env.example .env

#En el primer docker compose up -d con un volumen de InfluxDB vacio, el stack aprovisiona automaticamente la organizacion más los tres buckets de abajo (las variables de init solo se aplican en volúmenes vacíos — cambiarlas después requiere resetear el volumen).

#URL interna usada por Node-RED y Grafana dentro de la red de compose.
INFLUXDB_URL=http://influxdb:8086

#Usuario admin inicial de InfluxDB (creado solo en el primer arranque).
INFLUXDB_INIT_USERNAME=admin
#Contraseña admin inicial (obligatoria; elegir una fuerte para maquinas compartidas).
#En influxdb  por obligacion tu contraseña debe ser de al menos 8 digitos
INFLUXDB_INIT_PASSWORD=TU_CONTRASEÑA_SEGURA

#Organización aprovisionada en el primer arranque.
INFLUXDB_ORG=smart-factory

#Buckets aprovisionados en el primer arranque (retencion compartida, ver abajo).
INFLUXDB_BUCKET_MIR=mir_robots
INFLUXDB_BUCKET_PRINTER=3d_printers
INFLUXDB_BUCKET_DOBOT=dobot

MIR1_TOKEN=REEMPLAZAR_POR_MIR_TOKEN
MIR2_TOKEN=MIR1_TOKEN=REEMPLAZAR_POR_MIR_TOKEN

#Retencion para los tres buckets aprovisionados (p. ej. 30d, 90d, 0 = infinita).
#INFLUXDB_RETENTION=30d

#Token de admin asignado en el primer arranque (se elige aqui para que Node-RED y Grafana lo compartan sin tener que copiarlo y pegarlo). Reemplazar el placeholder.
INFLUXDB_TOKEN=REEMPLAZAR_POR_ADMIN_TOKEN

#Login inicial de admin de Grafana (cambiar la contraseña en cualquier maquina compartida).
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

#Mapeos de puertos del host (cambiar si algun puerto ya estas ocupado localmente).
NODE_RED_PORT=1880
INFLUXDB_PORT=8086
GRAFANA_PORT=3000


