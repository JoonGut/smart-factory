    {
        "id": "5b908ea4884424d3",
        "type": "function",
        "z": "518519e57122505a",
        "name": "function 1",
        "func": "let t1 = context.get('t1') ?? 10;\nlet t2 = context.get('t2') ?? 30;\nt1 = Math.min(15, Math.max(5, t1 + (Math.random() - 0.5)));\nt2 = Math.min(40, Math.max(20, t2 + (Math.random() - 0.5)));\ncontext.set('t1', t1);\ncontext.set('t2', t2);\nmsg.payload = { temp1: Math.round(t1 * 100) / 100, temp2: Math.round(t2 * 100) / 100 };\nreturn msg;\n",
