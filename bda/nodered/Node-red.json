    {
        "id": "f_prep",
        "type": "function",
        "z": "mir_multi_tab",
        "name": "preparar petición",
        "func": "// Un mensaje por robot MiR para pedirle datos a la API.\n// Las IPs se ven aquí; el token (secreto) viene de una variable de entorno.\nconst robots = [\n    { id: 'mir1', host: '192.168.15.5', token: env.get('MIR1_TOKEN') },\n    { id: 'mir2', host: '192.168.15.15', token: env.get('MIR2_TOKEN') }\n];\n\n// guartadamos las peticiones por robot\nconst salida = [];\nfor (const r of robots) {\n    // Si falta el token, se salta ese robot\n    if (!r.token) continue;   // guardamos de que robot es\n    salida.push({\n        topic: msg.topic,        // endpoint a pedir (status, missions...)\n        robot_id: r.id,          // sirve luego como etiqueta en InfluxDB\n        url: 'http://' + r.host + '/api/v2.0.0/' + msg.topic,\n        headers: {\n            'Authorization': 'Basic ' + r.token,\n            'Accept-Language': 'en_US'\n        }\n    });\n}\n// Un mensaje por cada robot\nreturn [salida];\n\n\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 150,
        "wires": [
            [
                "h_get"
            ]
        ]
