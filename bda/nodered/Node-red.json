    {
        "id": "ac7f979eaee47d56",
        "type": "function",
        "z": "mir_multi_tab",
        "name": "status -->influx ",
        "func": "// Solo procesamos las respuestas de \"status\"\nif (msg.topic !== 'status') return null;\n\n\n// s = JSON que devolvió el robot\nconst s = msg.payload;\nif (!s || typeof s !== 'object') return null;\n\n\n// Devuelve el valor si es número, si no null (InfluxDB fija el tipo del campo)\nconst n = (v) => (typeof v === 'number' ? v : null);\n\n\n// Valores numéricos a guardar (position y velocity son objetos anidados)\nconst candidatos = {\n    pos_x: n(s.position && s.position.x),\n    pos_y: n(s.position && s.position.y),\n    orientation: n(s.position && s.position.orientation),\n    vel_linear: n(s.velocity && s.velocity.linear),\n    vel_angular: n(s.velocity && s.velocity.angular),\n    battery_percentage: n(s.battery_percentage),\n    battery_time_remaining: n(s.battery_time_remaining),\n    moved: n(s.moved),\n    distance_to_next_target: n(s.distance_to_next_target),\n    uptime: n(s.uptime),\n    state_id: n(s.state_id),\n    mode_id: n(s.mode_id)\n};\n\n\n// Campos: nos quedamos solo con los que son número\nconst campos = {};\nfor (const k in candidatos) {\n    if (candidatos[k] !== null) campos[k] = candidatos[k];\n}\n\n\n// Otros campos: nº de errores, booleanos y texto de la misión\ncampos.errors_count = Array.isArray(s.errors) ? s.errors.length : 0;\ncampos.safety_system_muted = !!s.safety_system_muted;\ncampos.joystick_low_speed_mode = !!s.joystick_low_speed_mode_enabled;\ncampos.unloaded_map_changes = !!s.unloaded_map_changes;\ncampos.mission_text = String(s.mission_text || '');\n\n\n// Tags: categorías con pocos valores (nunca batería ni posición)\nconst tags = {\n    robot: String(msg.robot_id || 'desconocido'),   // mir1 o mir2\n    robot_name: String(s.robot_name || 'desconocido'),\n    robot_model: String(s.robot_model || 'desconocido'),\n    state_text: String(s.state_text || 'desconocido'),\n    mode_text: String(s.mode_text || 'desconocido'),\n    mode_key_state: String(s.mode_key_state || 'desconocido')\n};\n\n\n// Salida para influxdb out: [campos, tags]\nmsg.measurement = 'mir_status';\nmsg.payload = [campos, tags];\nreturn msg;\n\n\n\n",
